# Generated by esoBB Bootstrap — HTTP vhost.
# certbot --nginx adds the TLS server block + HTTP->HTTPS redirect.
# Friendly-URL handling mirrors the repo's nginx-config-example.conf.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root __ROOT__;
    index index.php;

    location / {
        try_files $uri $uri/ @rewrite;
    }

    location @rewrite {
        rewrite ^(.*)$ /index.php$1 last;
    }

    location ~ ^/index\.php(/.*)?$ {
        fastcgi_split_path_info ^(/index\.php)(/.*)$;
        include snippets/fastcgi-php.conf;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_pass unix:__PHP_SOCK__;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:__PHP_SOCK__;
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
